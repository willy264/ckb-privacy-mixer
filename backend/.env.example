# ── CKB Network ───────────────────────────────────────────────────────────────
CKB_RPC_URL=https://testnet.ckbapp.dev/rpc
CKB_INDEXER_URL=https://testnet.ckbapp.dev/indexer
CKB_NETWORK=testnet

# ── Relayer Service ───────────────────────────────────────────────────────────
RELAYER_PORT=4000

# Private key of the relayer's funded hot wallet (hex, no 0x prefix).
# This wallet pays CKB transaction gas fees on behalf of users.
# NEVER commit this value — keep it in .env only.
RELAYER_PRIVATE_KEY=your_relayer_private_key_here

# Fee taken by the relayer from each withdrawal (0.01 = 1%).
RELAYER_FEE_RATE=0.01

# Minimum network fee in shannons (1 CKB = 100,000,000 shannons).
RELAYER_MIN_FEE_SHANNONS=1000

# Public URL where users can reach this relayer (registered on-chain).
RELAYER_PUBLIC_URL=https://your-relayer-domain.com

# ── Coordinator Service ────────────────────────────────────────────────────────
COORDINATOR_PORT=4001

# How many participants are required to form a mixing pool.
COORDINATOR_MIN_PARTICIPANTS=5

# ── Redis (Required for Production) ────────────────────────────────────────────
# Redis connection string for persistent async task queuing and double-spend locks.
REDIS_URL=redis://127.0.0.1:6379

# ── On-Chain Relayer Registry (optional — leave blank if not yet deployed) ────
# When set, the frontend fetches the relayer list from this cell instead of
# hardcoding a single relayer, preserving decentralization.
RELAYER_REGISTRY_TX_HASH=
RELAYER_REGISTRY_INDEX=0x0

# ── Logging ───────────────────────────────────────────────────────────────────
LOG_LEVEL=info
