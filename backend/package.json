{
  "name": "ckb-mixer-backend",
  "version": "0.1.0",
  "description": "CKB Privacy Mixer — off-chain Relayer and Coordinator backend",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "dev:coordinator": "tsx watch src/index.ts",
    "dev:relayer": "tsx watch src/relayer/server.ts",
    "start:coordinator": "tsx src/coordinator/server.ts",
    "start:relayer": "tsx src/relayer/server.ts",
    "start": "node dist/index.js",
    "build": "tsc",
    "lint": "eslint . --ext ts --max-warnings 0"
  },
  "dependencies": {
    "@ckb-ccc/core": "^1.12.5",
    "@ckb-ccc/joy-id": "^1.0.32",
    "@nervosnetwork/ckb-sdk-utils": "0.109.5",
    "@waku/interfaces": "^0.0.34",
    "@waku/sdk": "^0.0.36",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-rate-limit": "^8.5.2",
    "ioredis": "^5.10.1",
    "mixer-sdk": "workspace:*",
    "protobufjs": "^8.5.0",
    "snarkjs": "^0.7.6",
    "uuid": "^9.0.1",
    "winston": "^3.11.0",
    "ws": "^8.14.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/express-rate-limit": "^6.0.2",
    "@types/node": "^20.0.0",
    "@types/snarkjs": "^0.7.9",
    "@types/uuid": "^9.0.7",
    "@types/ws": "^8.5.10",
    "tsx": "^4.6.0",
    "typescript": "^5.3.3"
  }
}
