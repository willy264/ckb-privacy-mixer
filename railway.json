{
  "$schema": "https://schema.railway.app/railpack-plan.schema.json",
  "build": {
    "builder": "RAILPACK",
    "buildCommand": "npm install -g pnpm && pnpm install --frozen-lockfile && pnpm --filter mixer-sdk build && pnpm --filter ckb-mixer-backend build"
  },
  "deploy": {
    "startCommand": "node --input-type=module -e \"import('./backend/dist/coordinator/server.js').then(({createCoordinatorServer})=>{const port=process.env.PORT||4001;createCoordinatorServer().listen(port,'0.0.0.0',()=>console.log('Coordinator on '+port));})\""
  }
}