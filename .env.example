# LEGACY DEMO CONFIGURATION ONLY.
# Corrected V1 receives an explicit validated deployment object and injected CCC
# Client; these variables do not make legacy contracts a V1 deployment.
CKB_RPC_URL=https://testnet.ckb.dev
CKB_INDEXER_URL=https://testnet.ckb.dev
MIXER_RUNTIME_MODE=preview
MIXER_WITHDRAWAL_AUTHORITY=direct

# Your deployed mixer contract
MIXER_POOL_TX_HASH=
MIXER_POOL_CODE_HASH=
MIXER_POOL_HASH_TYPE=data1

# Phase 3 / Phase 4 local contracts
NULLIFIER_TYPE_TX_HASH=
NULLIFIER_TYPE_CODE_HASH=
NULLIFIER_TYPE_HASH_TYPE=data1
ZK_MEMBERSHIP_TYPE_TX_HASH=
ZK_MEMBERSHIP_TYPE_CODE_HASH=
ZK_MEMBERSHIP_TYPE_HASH_TYPE=data1

# Initialized nullifier registry cell
NULLIFIER_REGISTRY_TX_HASH=
NULLIFIER_REGISTRY_INDEX=
NULLIFIER_REGISTRY_LOCK=
NULLIFIER_REGISTRY_CAPACITY=
NULLIFIER_REGISTRY_TYPE_ARGS=
NULLIFIER_REGISTRY_NULLIFIERS=

# Obscell deployed contracts on testnet (fill from Obscell deployment docs)
STEALTH_LOCK_CODE_HASH=
STEALTH_LOCK_HASH_TYPE=
CT_TOKEN_TYPE_CODE_HASH=
CT_TOKEN_TYPE_HASH_TYPE=
CT_INFO_TYPE_CODE_HASH=
CT_INFO_TYPE_HASH_TYPE=

# Legacy admin/deployment wallet only. Never expose this to frontend, coordinator,
# or public relayer processes. Normal corrected-V1 deposits use a user CCC Signer.
OWNER_PRIVATE_KEY=
