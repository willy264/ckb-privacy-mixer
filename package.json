{
  "name": "ckb-privacy-mixer",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "pnpm --filter frontend dev",
    "build": "pnpm --filter mixer-sdk build && pnpm --filter frontend build",
    "build:frontend": "pnpm --filter frontend build",
    "build:sdk": "pnpm --filter mixer-sdk build",
    "preview": "pnpm --filter frontend preview",
    "test:contracts": "cargo test --locked -p tests -j 1"
  },
  "dependencies": {
    "@ckb-lumos/base": "^0.22.2",
    "@ckb-lumos/helpers": "^0.23.0",
    "@ckb-lumos/lumos": "^0.23.0",
    "dotenv": "^16.6.1"
  }
}
