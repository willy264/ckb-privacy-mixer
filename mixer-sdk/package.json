{
  "name": "mixer-sdk",
  "version": "0.1.0",
  "description": "SDK for CKB Privacy Mixer",
  "type": "module",
  "main": "dist/v1/index.js",
  "types": "dist/v1/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/v1/index.js",
      "types": "./dist/v1/index.d.ts"
    },
    "./legacy": {
      "import": "./dist/legacy/index.js",
      "types": "./dist/legacy/index.d.ts"
    }
  },
  "scripts": {
    "build": "tsc",
    "check:v1": "tsc -p tsconfig.v1.json",
    "test": "pnpm run build && pnpm run check:v1 && node --test test/privacy-sdk.test.mjs"
  },
  "dependencies": {
    "@ckb-ccc/core": "^1.12.5",
    "@nervosnetwork/ckb-sdk-utils": "0.109.5",
    "@waku/interfaces": "^0.0.34",
    "@waku/sdk": "^0.0.36",
    "circomlibjs": "^0.1.7",
    "protobufjs": "^8.5.0",
    "snarkjs": "^0.7.6"
  },
  "devDependencies": {
    "typescript": "^5.0.0"
  }
}
