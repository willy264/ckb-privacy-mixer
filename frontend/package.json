{
  "name": "frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "start": "vite --open --port 3007",
    "prebuild": "pnpm --dir .. --filter mixer-sdk build",
