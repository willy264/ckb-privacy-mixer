{
  "name": "frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "start": "vite --open --port 3007",
    "prebuild": "pnpm --dir .. --filter mixer-sdk build",
    "build": "tsc && vite build",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "test:demo": "pnpm build && pnpm test:demo:client && pnpm test:demo:browser",
    "test:demo:browser": "node scripts/verify-demo.mjs",
    "test:demo:client": "tsx scripts/verify-demo-client.ts",
    "preview": "vite preview"
  },
  "dependencies": {
    "@ckb-ccc/core": "^1.12.5",
    "@ckb-ccc/joy-id": "^1.0.32",
    "@waku/interfaces": "^0.0.34",
    "@waku/sdk": "^0.0.36",
    "framer-motion": "^10.16.4",
    "lucide-react": "^0.279.0",
    "mixer-sdk": "workspace:*",
    "protobufjs": "^8.5.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "devDependencies": {
    "@types/react": "^18.2.15",
    "@types/react-dom": "^18.2.7",
    "@vitejs/plugin-react": "^4.0.3",
    "autoprefixer": "^10.4.15",
    "postcss": "^8.5.23",
    "playwright": "1.55.1",
    "tailwindcss": "^3.3.3",
    "tsx": "4.22.1",
    "typescript": "^5.0.2",
    "vite": "^4.4.5",
    "vite-plugin-node-polyfills": "^0.26.0"
  }
}
